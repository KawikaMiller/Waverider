<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Waverider.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vis="using:Waverider.Visualization"
    xmlns:vm="using:Waverider.ViewModels"
    xmlns:local="using:Waverider.Views"
    xmlns:theming="using:Waverider.Theming"
    xmlns:disc="using:Waverider.Disc"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Content area. Two layouts, switched in code (PlayerView.ApplyLayout):
               Now Playing:  [ visualizer          | album art    ]
                                                   | track info   ]
               Browse:       [ library / search    | visualizer   ]
                                                   | art + info   ]
             Cells: columns (*, 360), rows (*, *, Auto). -->
        <Grid x:Name="ContentGrid" Grid.Row="0" RowSpacing="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Browse layout: the library lives here instead of the slide-over drawer. -->
            <Border x:Name="BrowseHost"
                    Grid.Column="0"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Padding="14,12,14,12"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AppStrokeBrush}"
                    Background="{ThemeResource AppPanelBrush}" />

            <Border x:Name="VisualizerCard"
                    Grid.Column="0"
                    Grid.RowSpan="3"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AppStrokeBrush}"
                    Background="{ThemeResource AppStageBrush}">
                <Grid>
                    <vis:VisualizerHost x:Name="Visualizer" />

                    <StackPanel VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8"
                                Padding="12">
                        <Button x:Name="CustomizeButton"
                                Click="OnCustomizeClick"
                                ToolTipService.ToolTip="Edit this visualizer, or make a copy of it to customize">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                                <TextBlock Text="Customize" />
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="VisualizerCombo"
                                  Width="180"
                                  SelectionChanged="OnVisualizerChanged"
                                  PlaceholderText="Visualizer" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ArtCard"
                    Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AppStrokeBrush}"
                    Background="{ThemeResource AppPanelBrush}">
                <!-- A spinning vinyl / CD showing the album art (see Waverider.Disc). -->
                <disc:DiscView x:Name="Disc" Margin="10" />
            </Border>

            <StackPanel x:Name="InfoPanel" Grid.Column="1" Grid.Row="2" Spacing="2">
                <TextBlock x:Name="TrackTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TrackArtist" FontSize="14" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="TrackAlbum" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- Editors (full-size UI only): cover the right column so the whole visualizer stays
                 visible while tweaking it (the visualizer editor forces the Now Playing layout). -->
            <Border x:Name="EditorHost"
                    Grid.Column="1"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Padding="14,12,4,12"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AppStrokeBrush}"
                    Background="{ThemeResource AppPanelBrush}">
                <local:VisualizerEditorPanel x:Name="Editor" />
            </Border>
            <Border x:Name="ThemeEditorHost"
                    Grid.Column="1"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Padding="14,12,4,12"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AppStrokeBrush}"
                    Background="{ThemeResource AppPanelBrush}">
                <local:ThemeEditorPanel x:Name="ThemeEditor" />
            </Border>
        </Grid>

        <!-- Transport -->
        <Grid Grid.Row="1" Margin="0,12,0,0" Padding="18,10,18,12" RowSpacing="4"
              CornerRadius="12"
              BorderThickness="1"
              BorderBrush="{ThemeResource AppStrokeBrush}"
              Background="{ThemeResource AppPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ProgressLabel" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12" />
                <Slider Grid.Column="1" x:Name="SeekSlider"
                        Minimum="0" Maximum="1" Value="0"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="OnSeekChanged"
                        AutomationProperties.Name="Seek" />
                <TextBlock Grid.Column="2" x:Name="DurationLabel" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button Click="OnShuffleClick" ToolTipService.ToolTip="Shuffle">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                </Button>
                <Button Click="OnPreviousClick" ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button x:Name="PlayPauseButton" Click="OnPlayPauseClick" Style="{ThemeResource AccentButtonStyle}"
                        Width="64" Height="40">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18" />
                </Button>
                <Button Click="OnNextClick" ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <Button Click="OnRepeatClick" ToolTipService.ToolTip="Repeat">
                    <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="14" />
                </Button>
                <Button x:Name="LikeButton" Click="OnLikeClick" ToolTipService.ToolTip="Save to Liked Songs">
                    <FontIcon x:Name="LikeIcon" Glyph="&#xEB51;" FontSize="14" />
                </Button>
                <Button x:Name="DeviceButton" Click="OnDeviceClick" ToolTipService.ToolTip="Playback device">
                    <FontIcon Glyph="&#xE772;" FontSize="14" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                    <FontIcon x:Name="VolumeIcon" Glyph="&#xE995;" FontSize="14" />
                    <Slider x:Name="VolumeSlider"
                            Width="120"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            ValueChanged="OnVolumeChanged"
                            AutomationProperties.Name="Volume" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Library drawer: browse, search, queue. Full-size UI only. -->
        <Border x:Name="LibraryHost"
                Grid.Row="0"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                Width="440"
                Padding="14,12,14,12"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource AppStrokeBrush}"
                Background="{ThemeResource AppPanelBrush}">
            <local:LibraryPanel x:Name="Library" />
        </Border>

        <!-- Settings flyout panel (overlay) -->
        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#80000000">
            <Border HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="380" Padding="16"
                    Background="{ThemeResource AppPanelBrush}"
                    BorderBrush="{ThemeResource AppStrokeBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollMode="Auto">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
                            <Button Content="✕" HorizontalAlignment="Right" Click="OnCloseSettingsClick" />
                        </Grid>

                        <TextBlock Text="Theme" FontWeight="SemiBold" />
                        <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnThemeChanged"
                                  PlaceholderText="Theme" />
                        <Button Content="Customize theme…" HorizontalAlignment="Stretch" Click="OnCustomizeThemeClick" />

                        <TextBlock Text="Album art disc" FontWeight="SemiBold" />
                        <ComboBox x:Name="DiscSkinCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnDiscSkinChanged">
                            <ComboBoxItem Content="Vinyl record" Tag="Vinyl" />
                            <ComboBoxItem Content="Compact disc" Tag="Cd" />
                        </ComboBox>

                        <TextBlock Text="Disc face" FontWeight="SemiBold" />
                        <ComboBox x:Name="DiscFaceCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnDiscFaceChanged">
                            <ComboBoxItem Content="Album art" Tag="Art" />
                            <ComboBoxItem Content="Visualizer (vinyl: over the grooves, CD: replaces the art)" Tag="Visualizer" />
                        </ComboBox>
                        <CheckBox x:Name="DiscSpinCheck" Content="Visualizer spins with the disc"
                                  Checked="OnDiscSpinChanged" Unchecked="OnDiscSpinChanged" />

                        <TextBlock Text="Mini player" FontWeight="SemiBold" />
                        <ComboBox x:Name="MiniKindCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnMiniKindChanged">
                            <ComboBoxItem Content="Visualizer" Tag="Visualizer" />
                            <ComboBoxItem Content="Spinning disc" Tag="Disc" />
                        </ComboBox>

                        <TextBlock Text="Audio capture" FontWeight="SemiBold" />
                        <ComboBox x:Name="CaptureModeCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnCaptureModeChanged"
                                  PlaceholderText="Capture source">
                            <ComboBoxItem Content="This app (built-in player)" Tag="ThisApp" />
                            <ComboBoxItem Content="Spotify desktop app only" Tag="SpotifyOnly" />
                            <ComboBoxItem Content="All system audio" Tag="SystemLoopback" />
                        </ComboBox>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="OnStartCaptureClick" HorizontalAlignment="Stretch">
                                <TextBlock Text="Start" />
                            </Button>
                            <Button Grid.Column="1" Click="OnStopCaptureClick" HorizontalAlignment="Stretch">
                                <TextBlock Text="Stop" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Spotify" FontWeight="SemiBold" />
                        <Button x:Name="SignOutButton" Click="OnSignOutClick" HorizontalAlignment="Stretch">
                            <TextBlock Text="Sign out" />
                        </Button>

                        <TextBlock Text="Tips" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Use &quot;Customize theme…&quot; to create and tweak your own themes live (colors, mode, window material). Your visualizers and themes are saved under %LocalAppData%\Waverider." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
