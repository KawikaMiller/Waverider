<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Waverider.Views.MiniDiscView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:disc="using:Waverider.Disc"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Mini disc mode: the disc IS the window (the window itself is transparent and frameless).
         Hovering the disc slides in a marquee with the track and artist. Click toggles play / pause,
         press-and-drag moves the window, right-click opens the menu. -->
    <Grid x:Name="Root"
          Background="Transparent"
          SizeChanged="OnRootSizeChanged"
          PointerEntered="OnPointerMoved"
          PointerMoved="OnPointerMoved"
          PointerExited="OnPointerExited"
          PointerPressed="OnPointerPressed"
          PointerReleased="OnPointerReleased"
          PointerCanceled="OnPointerLost"
          PointerCaptureLost="OnPointerLost"
          AutomationProperties.Name="Waverider mini player. Click to play or pause.">

        <disc:DiscView x:Name="Disc" />

        <Border x:Name="MarqueeBand"
                Opacity="0"
                IsHitTestVisible="False"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="#B8000000">
            <Border.OpacityTransition>
                <ScalarTransition />
            </Border.OpacityTransition>
            <Grid x:Name="MarqueeClip" SizeChanged="OnMarqueeClipSizeChanged">
                <TextBlock x:Name="MarqueeText"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
