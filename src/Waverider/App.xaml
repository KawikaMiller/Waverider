<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Waverider.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Waverider">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Panel palette; values are overwritten from the active theme (ThemeService.ApplyPanelBrushes). -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#E8EBE4" />
            <SolidColorBrush x:Key="AppStageBrush" Color="#0F1913" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="#AEB5A9" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
